# The log level of the program. Use `error`, `warn`, `info`, `debug` or `trace`.
# You can also use a filter for one crate, for example `reverse_proxy=debug`.
# The default is `info`. At `debug`, the `h2` crate also logs every HTTP/2 frame.
# To avoid this, use `reverse_proxy=debug`.
export RUST_LOG="info"

# The address (`host:port`) of the `proxy` mode. The default is `127.0.0.1:8080`.
export PROXY_ADDR="127.0.0.1:8080"

# The address (`host:port`) of the `server` mode. The proxy sends its requests to
# this address. The default is `127.0.0.1:9000`.
export SERVER_ADDR="127.0.0.1:9000"

# The path of the certificate file (PEM) for the `proxy` mode. The proxy needs
# it to accept HTTPS. There is no default. Make the dev files with
# `./scripts/gen-dev-certs.sh`.
export PROXY_TLS_CERT="dev-certs/server.pem"

# The path of the private key file (PEM) for the certificate. There is no default.
export PROXY_TLS_KEY="dev-certs/server.key"

# The path of the CA bundle file (PEM) for the `proxy` mode. The proxy accepts
# only clients with a certificate that this CA signed. There is no default. The
# dev CA from `./scripts/gen-dev-certs.sh` signs the dev client certificates.
export PROXY_CLIENT_CA="dev-certs/ca.pem"

# The path of the policy file (YAML) for the `proxy` mode. It says which client
# identity may send which requests. There is no default. See `policies.yaml`.
export PROXY_POLICY_FILE="policies.yaml"

# How long the client has to send the request head, and then the request body,
# in seconds. It must be a whole number, more than 0. After that, the client gets
# `408` (or the connection closes). The default is `10`.
export PROXY_CLIENT_TIMEOUT_SECS="10"

# How long the proxy waits for the response head from the upstream, in seconds.
# It must be a whole number, more than 0. After that, the client gets `504`.
# The default is `10`.
export PROXY_UPSTREAM_TIMEOUT_SECS="10"

# The largest request body that the proxy accepts from a client, in bytes. It
# must be a whole number. `0` means no limit. A larger body gets `413`. The
# default is `1048576` (1 MiB).
export PROXY_MAX_REQUEST_BODY_BYTES="1048576"

# The largest response body that the proxy accepts from the upstream, in bytes.
# It must be a whole number. `0` means no limit. A larger body gets `502`, or
# the response stops if the proxy already sent the head. The default is
# `1048576` (1 MiB).
export PROXY_MAX_RESPONSE_BODY_BYTES="1048576"

# Where the proxy sends spans and metrics (OTLP over HTTP). If you do not set
# it, the proxy exports nothing. Example for a local collector:
# export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# The service name in the spans and metrics. The default is `reverse-proxy`.
# export OTEL_SERVICE_NAME="reverse-proxy"
